rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function google() { return request.auth != null && request.auth.token.email_verified == true && request.auth.token.firebase.sign_in_provider == 'google.com'; }
  function customer() { return request.auth != null && request.auth.token.email_verified == true && (request.auth.token.firebase.sign_in_provider == 'google.com' || request.auth.token.firebase.sign_in_provider == 'password'); }
  // Retain existing owner records to preserve access during the Admin rename.
  function freshAdmin() { return google() && request.time.toMillis() >= request.auth.token.auth_time * 1000 && request.time.toMillis() < request.auth.token.auth_time * 1000 + 1800000; }
  function admin() { return freshAdmin() && exists(/databases/$(database)/documents/owners/$(request.auth.uid)) && get(/databases/$(database)/documents/owners/$(request.auth.uid)).data.enabled == true; }
  match /owners/{uid} { allow get: if freshAdmin() && request.auth.uid == uid; allow list, write: if false; }
  // One server-enforced ledger per account: five requests per rolling day,
  // at least one minute apart. The ledger must be written with the new booking.
  match /bookingLimits/{uid} {
   allow get: if customer() && request.auth.uid == uid;
   allow list, delete: if false;
   allow create, update: if customer() && request.auth.uid == uid && validLimit();
   function validLimit() {
    let d = request.resource.data;
    let freshWindow = !exists(/databases/$(database)/documents/bookingLimits/$(uid)) || request.time >= resource.data.windowStart + duration.value(24,'h');
    let b = getAfter(/databases/$(database)/documents/bookings/$(d.bookingId)).data;
    return d.keys().hasOnly(['bookingId','windowStart','lastAt','count'])
     && d.bookingId is string && d.count is int && d.count >= 1 && d.count <= 5
     && d.lastAt == request.time
     && (!exists(/databases/$(database)/documents/bookingLimits/$(uid)) || request.time >= resource.data.lastAt + duration.value(60,'s'))
     && (freshWindow ? (d.windowStart == request.time && d.count == 1) :
       (d.windowStart == resource.data.windowStart && d.count == resource.data.count + 1 && request.time >= resource.data.lastAt + duration.value(60,'s')))
     && !exists(/databases/$(database)/documents/bookings/$(d.bookingId))
     && b.uid == uid && b.createdAt == request.time;
   }
  }
  match /closedDates/{date} {
   allow read: if true;
   allow create, update, delete: if admin();
  }
  match /vacationJobs/{id} { allow read, write: if admin(); }
  match /timeLocks/{key} {
   allow read: if true;
   allow create: if admin() || validLock(key);
   allow update, delete: if admin();
   function validLock(key) {
    let data = request.resource.data;
    let b = getAfter(/databases/$(database)/documents/bookings/$(data.bookingId)).data;
    let start = int(b.startAt.toMillis() / 3600000);
    return customer() && data.keys().hasOnly(['hour','bookingId'])
     && data.hour is int && key == string(data.hour)
     && !exists(/databases/$(database)/documents/bookings/$(data.bookingId))
     && b.uid == request.auth.uid && data.hour >= start && data.hour < start + int((b.get('durationMinutes',180) + 59) / 60) + 1;
   }
  }
  match /bookings/{id} {
   allow read: if admin() || (customer() && resource.data.uid == request.auth.uid);
   allow update: if admin();
   allow delete: if false;
   allow create: if customer() && validBooking(id);
   function person(p) { return p is map && p.keys().hasOnly(['name','makeup']) && p.name is string && p.name.size() > 0 && p.name.size() <= 100 && (p.makeup == 'guest' || p.makeup == 'bridal'); }
   function minutes(p) { return p.makeup == 'bridal' ? 90 : 60; }
   function held(hour,id) { return getAfter(/databases/$(database)/documents/timeLocks/$(string(hour))).data.bookingId == id; }
   // Belgium uses EU daylight saving: last Sunday of March/October, 01:00 UTC.
   function dstBoundary(year,month) {
    let last = int(timestamp.date(year,month,31).toMillis() / 86400000);
    return timestamp.value((last - ((last + 4) % 7)) * 86400000 + 3600000);
   }
   function localDate(t) { return timestamp.value(t.toMillis() + ((t >= dstBoundary(t.year(),3) && t < dstBoundary(t.year(),10)) ? 7200000 : 3600000)).date(); }
   function localHour(t) { return t.hours() + ((t >= dstBoundary(t.year(),3) && t < dstBoundary(t.year(),10)) ? 2 : 1); }
   function dateString(t) { return string(t.year()) + '-' + (t.month() < 10 ? '0' : '') + string(t.month()) + '-' + (t.day() < 10 ? '0' : '') + string(t.day()); }
   function closureAllows(b) {
    let path = /databases/$(database)/documents/closedDates/$(b.date);
    let hours = exists(path) ? get(path).data.get('hours',[-1]) : [];
    return !exists(path) || (!hours.hasAny([-1,b.hour,b.hour+1])
     && (b.durationMinutes <= 60 || !hours.hasAny([b.hour+2]))
     && (b.durationMinutes <= 120 || !hours.hasAny([b.hour+3]))
     && (b.durationMinutes <= 180 || !hours.hasAny([b.hour+4]))
     && (b.durationMinutes <= 240 || !hours.hasAny([b.hour+5])));
   }
   function validBooking(id) {
    let b = request.resource.data;
    let start = int(b.startAt.toMillis() / 3600000);
    return b.keys().hasOnly(['date','hour','name','phone','address','people','note','consent','uid','email','status','reservationFee','currency','startAt','createdAt','durationMinutes'])
     && b.uid == request.auth.uid && b.email == request.auth.token.email
     && b.name is string && b.name.size() > 0 && b.name.size() <= 100
     && b.phone is string && b.phone.matches('^[+][1-9][0-9]{7,14}$')
     && b.address is string && b.address.size() > 0 && b.address.size() <= 500
     && b.note is string && b.note.size() <= 1000 && b.consent == true
     && b.people is list && b.people.size() >= 1 && b.people.size() <= 3
     && person(b.people[0]) && (b.people.size() < 2 || person(b.people[1])) && (b.people.size() < 3 || person(b.people[2]))
     && b.durationMinutes is int && b.durationMinutes == minutes(b.people[0]) + (b.people.size() > 1 ? minutes(b.people[1]) : 0) + (b.people.size() > 2 ? minutes(b.people[2]) : 0)
     && b.reservationFee == b.people.size() * 2000 && b.currency == 'eur'
     && b.status == 'pending_payment' && b.createdAt == request.time
     && getAfter(/databases/$(database)/documents/bookingLimits/$(request.auth.uid)).data.bookingId == id
     && getAfter(/databases/$(database)/documents/bookingLimits/$(request.auth.uid)).data.lastAt == request.time
     && closureAllows(b)
     && b.hour is int && b.hour >= 9 && b.hour <= 19
     && b.startAt is timestamp && b.startAt > request.time && b.startAt.date() > localDate(request.time)
     && b.startAt.minutes() == 0 && b.startAt.seconds() == 0 && b.startAt.nanos() == 0
     && b.hour == localHour(b.startAt) && b.date == dateString(b.startAt)
     && held(start,id) && held(start + 1,id)
     && (b.get('durationMinutes',180) <= 60 || held(start + 2,id))
     && (b.get('durationMinutes',180) <= 120 || held(start + 3,id))
     && (b.get('durationMinutes',180) <= 180 || held(start + 4,id))
     && (b.get('durationMinutes',180) <= 240 || held(start + 5,id));
   }
  }
  // Previous collections are read-only for the admin during migration.
  match /slots/{id} { allow read: if admin(); allow write: if false; }
  match /{document=**} { allow read, write: if false; }
 }
}
